{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "../../../macOS/bundle/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "../../../macOS/bundle/Passyble.entitlements",
      "infoPlist": "../../../macOS/bundle/Info.plist",
      "dmg": {
        "windowSize": { "width": 600, "height": 380 },
        "appPosition": { "x": 160, "y": 180 },
        "applicationFolderPosition": { "x": 440, "y": 180 }
      }
    }
  }
}
