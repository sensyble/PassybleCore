{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Passyble",
  "mainBinaryName": "Pass",
  "identifier": "com.sensyble.pass",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Passyble",
        "url": "index.html",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "contentProtected": true
      },
      {
        "label": "prompt",
        "create": false,
        "title": "Passyble",
        "url": "prompt.html",
        "width": 440,
        "height": 280,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false,
        "contentProtected": true
      },
      {
        "label": "totp",
        "create": false,
        "title": "Passyble code",
        "url": "totp.html",
        "width": 320,
        "height": 136,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": true,
        "visible": false,
        "contentProtected": true
      },
      {
        "label": "quickpick",
        "create": false,
        "title": "Passyble auto-type",
        "url": "quickpick.html",
        "width": 520,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": true,
        "visible": false,
        "contentProtected": true
      },
      {
        "label": "quickaccess",
        "create": false,
        "title": "Passyble Quick Access",
        "url": "quickaccess.html",
        "width": 600,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": true,
        "visible": false,
        "contentProtected": true
      },
      {
        "label": "qrscan",
        "create": false,
        "title": "Passyble two-factor code",
        "url": "qrscan.html",
        "width": 480,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": true,
        "visible": false,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["pass+server", "passyble"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyRTg4RTI1MUZDOTI1OTcKUldTWEpja2ZKWTdvTXZUN0luU3dDTFZoK1BsZ2M1SnJaZWdkaXVncmpiRTIzY0lPZmp5TmkyQnEK",
      "endpoints": [
        "https://github.com/sensyble/pass-releases/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": false,
    "publisher": "Sensyble",
    "category": "Utility",
    "shortDescription": "Password manager with auto-type, 2FA codes and passkeys",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "../../../Windows/installer/installer-hooks.nsh",
        "languages": ["English", "Spanish", "French", "German", "SimpChinese", "Japanese", "Korean", "Hindi", "Indonesian"],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "German": "../../../Windows/installer/nsis-lang/German.nsh",
          "Hindi": "../../../Windows/installer/nsis-lang/Hindi.nsh",
          "Indonesian": "../../../Windows/installer/nsis-lang/Indonesian.nsh"
        }
      },
      "wix": {
        "upgradeCode": "D4B7ACC3-C438-4E5D-AA8F-EC10FAB82A61",
        "language": "en-US",
        "fragmentPaths": ["../../../Windows/installer/passkey-cleanup.wxs"],
        "componentRefs": ["PassPasskeyCleanup"]
      }
    }
  }
}
